<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackground">#F8F7FA</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarBackground">#EEECF2</SolidColorBrush>
  <SolidColorBrush x:Key="SeparatorBrush">#E0DCE6</SolidColorBrush>
  <SolidColorBrush x:Key="PrimaryText">#262433</SolidColorBrush>
  <SolidColorBrush x:Key="SecondaryText">#686374</SolidColorBrush>
  <SolidColorBrush x:Key="CaptionText">#716A7D</SolidColorBrush>
  <SolidColorBrush x:Key="WindowBorder">#CFCAD8</SolidColorBrush>
  <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="CardBorder">#E9E6EE</SolidColorBrush>
  <SolidColorBrush x:Key="ControlBackground">#F3F1F7</SolidColorBrush>
  <SolidColorBrush x:Key="ControlBorder">#D5CFE0</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBrush">#7455DA</SolidColorBrush>
  <SolidColorBrush x:Key="AccentHoverBrush">#6547C7</SolidColorBrush>
  <SolidColorBrush x:Key="AccentPressedBrush">#563BB7</SolidColorBrush>
  <SolidColorBrush x:Key="AccentForeground">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="SelectedBackground">#E1DBF1</SolidColorBrush>
  <SolidColorBrush x:Key="SelectedForeground">#6244B7</SolidColorBrush>
  <SolidColorBrush x:Key="IndicatorBackground">#F3EFFC</SolidColorBrush>
  <SolidColorBrush x:Key="IndicatorRing">#E3DBF8</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBackground">#FFF0EF</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBorder">#F1CFCA</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorForeground">#AE4940</SolidColorBrush>
  <SolidColorBrush x:Key="CloseFill">#FF5F57</SolidColorBrush>
  <SolidColorBrush x:Key="CloseBorder">#E64740</SolidColorBrush>
  <SolidColorBrush x:Key="MinimizeFill">#FEBC2E</SolidColorBrush>
  <SolidColorBrush x:Key="MinimizeBorder">#DFA020</SolidColorBrush>
  <SolidColorBrush x:Key="MaximizeFill">#28C840</SolidColorBrush>
  <SolidColorBrush x:Key="MaximizeBorder">#20AA33</SolidColorBrush>
</ResourceDictionary>
