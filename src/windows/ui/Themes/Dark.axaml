<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackground">#1B1921</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarBackground">#211E29</SolidColorBrush>
  <SolidColorBrush x:Key="SeparatorBrush">#37323F</SolidColorBrush>
  <SolidColorBrush x:Key="PrimaryText">#F0EDF6</SolidColorBrush>
  <SolidColorBrush x:Key="SecondaryText">#BCB5C9</SolidColorBrush>
  <SolidColorBrush x:Key="CaptionText">#AFA6C0</SolidColorBrush>
  <SolidColorBrush x:Key="WindowBorder">#51495F</SolidColorBrush>
  <SolidColorBrush x:Key="CardBackground">#26222F</SolidColorBrush>
  <SolidColorBrush x:Key="CardBorder">#3C3549</SolidColorBrush>
  <SolidColorBrush x:Key="ControlBackground">#342D40</SolidColorBrush>
  <SolidColorBrush x:Key="ControlBorder">#5A4F6B</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBrush">#B29AF5</SolidColorBrush>
  <SolidColorBrush x:Key="AccentHoverBrush">#C2AFF9</SolidColorBrush>
  <SolidColorBrush x:Key="AccentPressedBrush">#9E80EC</SolidColorBrush>
  <SolidColorBrush x:Key="AccentForeground">#211833</SolidColorBrush>
  <SolidColorBrush x:Key="SelectedBackground">#3E3158</SolidColorBrush>
  <SolidColorBrush x:Key="SelectedForeground">#D2C1FF</SolidColorBrush>
  <SolidColorBrush x:Key="IndicatorBackground">#332840</SolidColorBrush>
  <SolidColorBrush x:Key="IndicatorRing">#584273</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBackground">#41282C</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBorder">#75474D</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorForeground">#FFB6AF</SolidColorBrush>
  <SolidColorBrush x:Key="CloseFill">#FF5F57</SolidColorBrush>
  <SolidColorBrush x:Key="CloseBorder">#E64740</SolidColorBrush>
  <SolidColorBrush x:Key="MinimizeFill">#FEBC2E</SolidColorBrush>
  <SolidColorBrush x:Key="MinimizeBorder">#DFA020</SolidColorBrush>
  <SolidColorBrush x:Key="MaximizeFill">#28C840</SolidColorBrush>
  <SolidColorBrush x:Key="MaximizeBorder">#20AA33</SolidColorBrush>
</ResourceDictionary>
