<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OuternetAWG.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>OuternetAWG</AssemblyName>
    <RootNamespace>OuternetAWG</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OuternetAWG.UI.Tests" />
    <EmbeddedResource Include="Locales\*.json" WithCulture="false" />
    <AvaloniaResource Include="Assets\OuternetAWG.ico" />
    <None Update="Assets\OuternetAWG.ico" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" TargetPath="OuternetAWG.ico" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
</Project>
